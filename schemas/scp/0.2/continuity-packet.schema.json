        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
              },
              "kind": {
                "const": "symlink"
              }
            },
            "required": [
              "state",
              "kind"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "120000"
              }
            },
            "required": [
              "digest"
            ],
            "not": {
              "required": [
                "gitlink_commit"
