          "enum": [
            "100644",
            "100755",
            "120000",
            "160000",
            "unknown"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "gitlink_commit": {
          "$ref": "#/$defs/git_oid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "present"
