    "worktree_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "scope",
        "digest_algorithm",
        "path_encoding",
        "started_at",
        "completed_at",
        "coverage",
        "observation",
        "entries"
      ],
      "properties": {
        "format": {
          "const": "scp-worktree-fingerprint/1"
        },
        "scope": {
          "const": "git-status-paths"
        },
        "digest_algorithm": {
          "const": "sha-256"
        },
        "path_encoding": {
          "const": "utf-8"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "observation": {
          "enum": [
            "per_path_stable",
            "changed_during_capture",
            "unknown"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktree_fingerprint_entry"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "complete"
              }
            },
            "required": [
              "coverage"
            ]
          },
          "then": {
            "properties": {
              "observation": {
                "const": "per_path_stable"
              },
              "entries": {
                "items": {
                  "properties": {
                    "worktree": {
                      "anyOf": [
                        {
                          "properties": {
                            "state": {
                              "const": "absent"
                            }
                          },
                          "required": [
                            "state"
                          ]
                        },
                        {
                          "properties": {
                            "state": {
                              "const": "present"
                            },
                            "kind": {
                              "enum": [
                                "regular_file",
                                "symlink"
                              ]
                            }
                          },
                          "required": [
                            "state",
                            "kind"
                          ]
                        }
                      ]
                    },
                    "index_entries": {
                      "items": {
                        "properties": {
                          "mode": {
                            "enum": [
                              "100644",
                              "100755",
                              "120000"
                            ]
                          }
                        },
                        "required": [
                          "mode"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observation": {
                "const": "changed_during_capture"
              }
            },
            "required": [
              "observation"
            ]
          },
          "then": {
            "properties": {
              "coverage": {
                "enum": [
                  "partial",
                  "unknown"
                ]
              }
            }
          }
        }
      ],
      "description": "Per-path snapshot of Git-status-visible non-ignored changes. It is neither a backup nor a globally atomic worktree snapshot."
    }
