#!/bin/sh
# 通用提交闸门。缺少运行环境或检查器时必须失败关闭，不得静默放行。
# 启用：git config core.hooksPath .githooks
set -eu

if command -v node >/dev/null 2>&1 && [ -f .standards/check-governance.cjs ]; then
  echo "[pre-commit] 治理检查（Node）..."
  node .standards/check-governance.cjs
elif command -v python3 >/dev/null 2>&1 && [ -f .standards/check_governance.py ]; then
  echo "[pre-commit] 治理检查（Python 3）..."
  python3 .standards/check_governance.py
elif command -v python >/dev/null 2>&1 && [ -f .standards/check_governance.py ]; then
  echo "[pre-commit] 治理检查（Python）..."
  python .standards/check_governance.py
else
  echo "[pre-commit] ERROR: 找不到可用的治理检查运行环境或检查器。" >&2
  echo "请安装 Node.js 或 Python 3，并确认 .standards/check-governance.cjs / check_governance.py 存在。" >&2
  exit 1
fi

# 项目专属检查独立放在 pre-commit.local，避免升级通用 Hook 时覆盖项目逻辑。
if [ -f .githooks/pre-commit.local ]; then
  echo "[pre-commit] 项目专属检查..."
  sh .githooks/pre-commit.local
fi
